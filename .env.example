GEMINI_API_KEY=your_gemini_api_key_here
# Long random string, e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Comma-separated, tried in order. Run check_models.py to see valid names.
GEMINI_MODELS=gemini-2.5-flash
# Set to 1 only on your own machine.
FLASK_DEBUG=0
